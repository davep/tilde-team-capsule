#!/bin/bash

cat <<__HEADER__
=> .. Home
# ~~~~

# davep

The following is a selection of posts from my main blog.

=> https://blog.davep.org/

I write a *lot* more there; here I'll pull in the less day-to-day pieces.

## Posts

__HEADER__

for entry in site/gemlog/2*.gmi
do
    base_entry=$(basename $entry)
    entry_date=$(echo $base_entry | cut -d'-' -f1-3)
    entry_title=$(grep "# " "$entry" | head -2 | tail -1 | sed 's/^# //g' | sed 's/"//g')
    echo "=> $base_entry $entry_date - $entry_title"
done

echo
echo "# ~~~~"
echo "=> .. Home"

### update-gemlog-index ends here
